+    uint a = (uTexa.z != 0 && rgb == 0u) ? 0u : uint((v & 0x8000u) != 0u ? uTexa.y : uTexa.x);
+    v = rgb | (a << 15);
+    h = vec2(float(v & 255u), float(v >> 8)) / 255.0;
+    oColor = (uHd == 0) ? vec4(h, 0.0, 0.0) : vec4(0.0, 0.0, h);
