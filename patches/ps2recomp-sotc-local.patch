+    // A streaming buffer that stays mapped: writing into it costs no driver call, where mapping and unmapping for every
+    // draw was a fifth of the renderer's time on NVIDIA. Fences keep the CPU from overwriting a part the GPU hasn't read.
+    struct PersistentRing
+    {
+        static constexpr int kSectors = 4;
+        uint8_t *base = nullptr;
+        size_t capacity = 0u, sectorBytes = 0u, head = 0u;
+        int firstSector = 0;
+        std::array<GLsync, kSectors> fences{};
+        bool tried = false;
+
+        bool init(const Api &g, GLenum target, GLuint buffer, size_t bytes)
+        {
+            tried = true;
+            if (!g.BufferStorage || !g.FenceSync || !g.ClientWaitSync || !g.DeleteSync)
+                return false;
+            constexpr GLbitfield kFlags = 0x2u | 0x40u | 0x80u; // WRITE | PERSISTENT | COHERENT
+            g.BindBuffer(target, buffer);
+            g.BufferStorage(target, static_cast<GLsizeiptr>(bytes), nullptr, kFlags);
+            base = static_cast<uint8_t *>(g.MapBufferRange(target, 0, static_cast<GLsizeiptr>(bytes), kFlags));
+            capacity = bytes;
+            sectorBytes = bytes / kSectors;
+            return base != nullptr;
+        }
+
+        void waitFor(const Api &g, int sector)
+        {
+            if (GLsync fence = fences[sector])
+            {
+                g.ClientWaitSync(fence, kSyncFlushCommandsBit, 2000000000ull);
+                g.DeleteSync(fence);
+                fences[sector] = nullptr;
+            }
+        }
+
+        size_t allocate(const Api &g, size_t bytes, size_t align)
+        {
+            size_t offset = (head + align - 1u) / align * align;
+            const bool crosses = offset / sectorBytes != (offset + bytes - 1u) / sectorBytes || offset + bytes > capacity;
+            if (crosses)
+            {
+                // What has been written since the last crossing is now in flight.
+                const int lastUsed = static_cast<int>((head == 0u ? 0u : head - 1u) / sectorBytes);
+                for (int sector = firstSector; sector <= lastUsed; ++sector)
+                {
+                    if (fences[sector])
+                        g.DeleteSync(fences[sector]);
+                    fences[sector] = g.FenceSync(kSyncGpuCommandsComplete, 0u);
+                }
+                size_t next = (lastUsed + 1) % kSectors;
+                if (next * sectorBytes + bytes > capacity)
+                    next = 0u;
+                offset = next * sectorBytes;
+                firstSector = static_cast<int>(next);
+                const int lastNeeded = static_cast<int>((offset + bytes - 1u) / sectorBytes);
+                for (int sector = firstSector; sector <= lastNeeded; ++sector)
+                    waitFor(g, sector);
+            }
+            head = offset + bytes;
+            return offset;
+        }
+    };
