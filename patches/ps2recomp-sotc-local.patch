+}
+
+PresentationFrame GSHwBackend::Present(const GSPresentationRequest &request)
+{
+    Impl &d = *m_impl;
+    PresentationFrame frame;
+    if (!d.ensure())
+        return frame;
+    d.flushPending();
+    d.limitFramesInFlight();
+    ++d.presentCount;
+    d.dumpAfterSkip = false;
+    d.frameBatch = 0;
+    d.reportStats();
+    const bool enable1 = (request.pmode & 1ull) != 0ull, enable2 = (request.pmode & 2ull) != 0ull;
+    const auto decode = [&](bool enabled, uint64_t dispfb, uint64_t display, uint32_t &fbp, uint32_t &fbw, uint32_t &dbx, uint32_t &dby,
+                            uint32_t &w, uint32_t &h)
+    {
+        fbp = static_cast<uint32_t>(dispfb & 0x1FFu);
+        fbw = std::max<uint32_t>(1u, static_cast<uint32_t>((dispfb >> 9) & 0x3Fu));
+        dbx = static_cast<uint32_t>((dispfb >> 32) & 0x7FFu);
+        dby = static_cast<uint32_t>((dispfb >> 43) & 0x7FFu);
+        const uint32_t hdiv = static_cast<uint32_t>((display >> 23) & 0xFu) + 1u;
+        const uint32_t vdiv = static_cast<uint32_t>((display >> 27) & 0x3u) + 1u;
+        w = (static_cast<uint32_t>((display >> 32) & 0xFFFu) + 1u) / hdiv;
+        h = (static_cast<uint32_t>((display >> 44) & 0x7FFu) + 1u) / vdiv;
+        if ((request.smode2 & 3u) == 3u) // Field mode: each buffer holds one field's lines, half the display height.
+            h = (h + 1u) / 2u;
+        return enabled && display != 0u && w != 0u && h != 0u;
+    };
+    // GOW_GS_HW_DISPLOG=1: the display registers each time they change (picture size and placement per mode)
+    static const bool dispLog = std::getenv("GOW_GS_HW_DISPLOG") != nullptr;
+    static uint64_t lastDisp[6] = {};
+    if (dispLog && (request.pmode != lastDisp[0] || request.dispfb1 != lastDisp[1] || request.display1 != lastDisp[2] ||
+                    request.dispfb2 != lastDisp[3] || request.display2 != lastDisp[4] || request.smode2 != lastDisp[5]))
+    {
+        lastDisp[0] = request.pmode; lastDisp[1] = request.dispfb1; lastDisp[2] = request.display1;
+        lastDisp[3] = request.dispfb2; lastDisp[4] = request.display2; lastDisp[5] = request.smode2;
+        std::fprintf(stderr, "[gs-hw-disp] present=%d pmode=%llx smode2=%llx dispfb1=%llx display1=%llx dispfb2=%llx display2=%llx\n",
+                     d.presentCount, (unsigned long long)request.pmode, (unsigned long long)request.smode2, (unsigned long long)request.dispfb1,
+                     (unsigned long long)request.display1, (unsigned long long)request.dispfb2, (unsigned long long)request.display2);
+    }
+    if (d.statsEnabled)
+    {
+        static int shown = 0;
+        if (shown++ < 6)
+            std::fprintf(stderr, "[gs-hw] present pmode=%llx smode2=%llx dispfb1=%llx display1=%llx dispfb2=%llx display2=%llx\n",
+                         (unsigned long long)request.pmode, (unsigned long long)request.smode2, (unsigned long long)request.dispfb1,
+                         (unsigned long long)request.display1, (unsigned long long)request.dispfb2, (unsigned long long)request.display2);
+    }
+    // the two read circuits; circuit 1 is shown over circuit 2 (or BGCOLOR), blended by ALP (MMOD) or its own alpha x2
+    uint32_t fbp1, fbw1, dbx1, dby1, w1, h1, fbp2, fbw2, dbx2, dby2, w2, h2;
+    const bool ok1 = enable1 && decode(true, request.dispfb1, request.display1, fbp1, fbw1, dbx1, dby1, w1, h1);
+    const bool ok2 = enable2 && decode(true, request.dispfb2, request.display2, fbp2, fbw2, dbx2, dby2, w2, h2);
+    const bool shared = false; // This runtime always reads the frame back; no shared texture path.
+    if (!ok1 && !ok2)
+    {
+        if (shared)
+            return frame;
+        return frame;
+    }
+    // The host window shows the TV area of the game's own picture: 448 lines from DY 50 (gameplay, menus). The movies set
+    // a 480-line display at the same DY; their streams are 640x480 with the picture in the top 448 lines and 32 black
+    // lines below, which a TV shows in its bottom border. Taller displays are cut to 448 lines, so a movie fills the
+    // window like the game does instead of leaving a black band under it.
+    constexpr uint32_t kTvLines = 448u;
+    const uint32_t fbp = ok1 ? fbp1 : fbp2, w = ok1 ? w1 : w2, h = std::min(ok1 ? h1 : h2, kTvLines);
+    frame.displayFbp = fbp;
+    frame.sourceFbp = fbp;
+    // Videos and full-screen images are uploaded straight into the displayed buffer, so no render target holds them.
+    {
+        const uint32_t fbw = ok1 ? fbw1 : fbw2, dbx = ok1 ? dbx1 : dbx2, dby = ok1 ? dby1 : dby2;
+        const uint64_t dispfb = ok1 ? request.dispfb1 : request.dispfb2;
+        const uint32_t psm = static_cast<uint32_t>((dispfb >> 15) & 0x1Fu);
+        RenderTarget *shown = d.findTarget(fbp);
+        const bool uploaded = !shown || d.uploadedSinceDraw(*shown, fbp * 32u);
+        const GSSwizzle::Format &format = GSSwizzle::GetFormat(psm);
+        if (uploaded && d.vram && format.table)
+        {
+            const bool sixteen = format.kind == GSSwizzle::Kind::Bits16;
+            frame.pixels.resize(static_cast<size_t>(w) * h * 4u);
+            uint32_t *out = reinterpret_cast<uint32_t *>(frame.pixels.data());
+            for (uint32_t y = 0; y < h; ++y)
+            {
+                const GSSwizzle::AxisPart row = GSSwizzle::RowPart(format, fbp * 32u, fbw, y + dby);
+                for (uint32_t x = 0; x < w; ++x)
+                {
+                    const GSSwizzle::Location at = GSSwizzle::Combine(format, row, GSSwizzle::ColumnPart(format, x + dbx));
+                    const uint32_t raw = GSSwizzle::LoadAt(format, d.vram + at.byte, at.shift);
+                    out[static_cast<size_t>(y) * w + x] = (sixteen ? GSCpuInternal::Rgba5551ToRgba8888(static_cast<uint16_t>(raw)) : raw) | 0xFF000000u;
+                }
+            }
+            frame.width = w;
+            frame.height = h;
+            return frame;
+        }
+    }
+    // GOW_GS_HW_DISPDUMP=<n>: the n-th present after the displayed buffer's size changed (e.g. a movie starts) writes that
+    // whole render target to gs_hw_disp_<fbp>_<w>x<h>.ppm (what the read circuit can reach, beyond the displayed area)
+    static const int dispDumpAt = std::getenv("GOW_GS_HW_DISPDUMP") ? std::atoi(std::getenv("GOW_GS_HW_DISPDUMP")) : -1;
+    static uint32_t dispDumpSize = 0;
+    static int dispDumpCount = 0;
+    if (dispDumpAt >= 0)
+    {
+        if ((w << 16 | h) != dispDumpSize)
+            dispDumpSize = w << 16 | h, dispDumpCount = 0;
+        if (dispDumpCount++ == dispDumpAt)
+            if (RenderTarget *rt = d.findTarget(fbp))
+            {
+                std::vector<uint8_t> px(static_cast<size_t>(rt->glW) * rt->glH * 4u);
+                d.gl().BindFramebuffer(kFramebuffer, rt->fbo);
+                d.gl().PixelStorei(kPackAlignment, 1);
+                d.gl().ReadPixels(0, 0, rt->glW, rt->glH, kRgba, kUnsignedByte, px.data());
+                char name[64];
+                std::snprintf(name, sizeof(name), "gs_hw_disp_%u_%ux%u.ppm", fbp, w, h);
+                if (FILE *f = std::fopen(name, "wb"))
+                {
+                    std::fprintf(f, "P6 %u %u 255 ", rt->glW, rt->glH);
+                    for (size_t i = 0; i + 3 < px.size(); i += 4)
+                        std::fwrite(&px[i], 1, 3, f);
+                    std::fclose(f);
+                }
+            }
+    }
+    const uint32_t outW = static_cast<uint32_t>(std::ceil(w * d.scale)), outH = static_cast<uint32_t>(std::ceil(h * d.scale));
+    frame.width = outW;
+    frame.height = outH;
+    if (!shared)
+        frame.pixels.assign(static_cast<size_t>(outW) * outH * 4u, 0u);
+    const Api &g = d.gl();
+    g.PixelStorei(kPackAlignment, 1);
+    static const int depthDumpAt = std::getenv("GOW_GS_HW_DEPTHDUMP") ? std::atoi(std::getenv("GOW_GS_HW_DEPTHDUMP")) : -1;
+    if (depthDumpAt >= 0 && d.presentCount == depthDumpAt)
+    {
+        RenderTarget *main = d.findTarget(0);
+        if (main && main->depth)
+        {
+            std::vector<float> depth(static_cast<size_t>(main->glW) * main->glH);
+            g.BindFramebuffer(kFramebuffer, main->fbo);
+            g.ReadPixels(0, 0, main->glW, main->glH, kDepthComponent, kFloat, depth.data());
+            if (FILE *f = std::fopen("gs_hw_depth.pgm", "wb"))
+            {
+                std::fprintf(f, "P5 %u %u 255 ", main->glW, main->glH);
+                for (float v : depth)
+                {
+                    const uint8_t b = static_cast<uint8_t>(std::min(255.0f, std::max(0.0f, v * 255.0f)));
+                    std::fwrite(&b, 1, 1, f);
+                }
+                std::fclose(f);
+            }
+        }
+    }
+
+    // GOW_GS_HW_EDGELOG=1: every 300 presents, the displayed buffer's first host rows (at x = width/2) and columns
+    // (at y = height/2) before composition (edge artefacts: what the frame buffer holds there)
+    static const bool edgeLog = std::getenv("GOW_GS_HW_EDGELOG") != nullptr;
+    if (edgeLog && d.presentCount % 300 == 0)
+        if (RenderTarget *rt = d.findTarget(fbp))
+        {
+            uint8_t px[4 * 8];
+            g.BindFramebuffer(kFramebuffer, rt->fbo);
+            std::fprintf(stderr, "[gs-hw-edge] fbp=%x gl=%ux%u rows:", fbp, rt->glW, rt->glH);
+            for (uint32_t y = 0; y < 8; ++y)
+            {
+                g.ReadPixels(static_cast<GLint>(rt->glW / 2u), static_cast<GLint>(y), 1, 1, kRgba, kUnsignedByte, px);
+                std::fprintf(stderr, " %02x%02x%02x", px[0], px[1], px[2]);
+            }
+            std::fprintf(stderr, " cols:");
+            for (uint32_t x = 0; x < 8; ++x)
+            {
+                g.ReadPixels(static_cast<GLint>(x), static_cast<GLint>(rt->glH / 4u), 1, 1, kRgba, kUnsignedByte, px);
+                std::fprintf(stderr, " %02x%02x%02x", px[0], px[1], px[2]);
+            }
+            std::fprintf(stderr, " usedW=%u pxW=%u\n", rt->usedW, rt->pxW);
+        }
+
+    // compose the read circuits on the GPU, then read the result back once
+    if (!d.presentProgram)
+        return frame;
+    if (!d.presentFbo || d.presentW != outW || d.presentH != outH)
+    {
+        if (d.presentTex)
+            g.DeleteTextures(1, &d.presentTex);
+        if (!d.presentFbo)
+            g.GenFramebuffers(1, &d.presentFbo);
+        g.GenTextures(1, &d.presentTex);
+        g.BindTexture(kTexture2D, d.presentTex);
+        g.TexImage2D(kTexture2D, 0, static_cast<GLint>(kRgba8), outW, outH, 0, kRgba, kUnsignedByte, nullptr);
+        // complete without mipmaps (glCopyImageSubData refuses incomplete textures)
+        g.TexParameteri(kTexture2D, kTextureMinFilter, kLinear);
+        g.TexParameteri(kTexture2D, kTextureMagFilter, kLinear);
+        g.BindFramebuffer(kFramebuffer, d.presentFbo);
+        g.FramebufferTexture2D(kFramebuffer, kColorAttachment0, kTexture2D, d.presentTex, 0);
+        d.presentW = outW;
+        d.presentH = outH;
+    }
+    g.BindFramebuffer(kFramebuffer, d.presentFbo);
+    g.Viewport(0, 0, outW, outH);
+    g.Disable(kScissorTest);
+    g.Disable(kDepthTest);
+    g.ColorMask(kTrue, kTrue, kTrue, kTrue);
+    g.ClearColor(0.f, 0.f, 0.f, 1.f);
+    g.Clear(kColorBufferBit);
+    g.UseProgram(d.presentProgram);
+    g.BindVertexArray(d.presentVao);
+    g.ActiveTexture(kTexture0);
+    g.Uniform1i(d.locPresentSrc, 0);
+    // Row 0 of the displayed buffer is the game's black line (the 416 -> 448 stretch starts at y 0.5 and a line
+    // primitive clears row 0), which a TV's overscan hides on the console: the first two PS2 rows and columns repeat
+    // the next one so no dark line shows along the top and left edge.
+    g.Uniform1i(d.locPresentEdge, static_cast<GLint>(std::lround(2.0f * d.scale)));
+    const bool mmod = ((request.pmode >> 5) & 1u) != 0u, slbg = ((request.pmode >> 7) & 1u) != 0u;
+    const uint32_t alp = static_cast<uint32_t>((request.pmode >> 8) & 0xFFu);
+    const auto drawCircuit = [&](uint32_t cfbp, uint64_t dispfb, uint32_t cdbx, uint32_t cdby, bool alphaFactor)
+    {
+        RenderTarget *rt = d.findTarget(cfbp);
+        if (!rt)
+            return;
+        g.BindTexture(kTexture2D, rt->color);
+        g.TexParameteri(kTexture2D, kTextureMinFilter, kNearest);
+        g.TexParameteri(kTexture2D, kTextureMagFilter, kNearest);
+        g.Uniform4i(d.locPresentOffset, static_cast<GLint>(cdbx * d.scale), static_cast<GLint>(cdby * d.scale),
+                    ((dispfb >> 15) & 0x1Fu) == GS_PSM_CT24 ? 1 : 0, alphaFactor ? 1 : 0);
+        g.DrawArrays(kTriangles, 0, 3);
+        g.TexParameteri(kTexture2D, kTextureMinFilter, kLinear);
+        g.TexParameteri(kTexture2D, kTextureMagFilter, kLinear);
+    };
+    g.Disable(kBlend);
+    if (ok1 && ok2)
+    {
+        if (slbg)
+        {
+            g.ClearColor(static_cast<float>(request.bgcolor & 0xFFu) / 255.f, static_cast<float>((request.bgcolor >> 8) & 0xFFu) / 255.f,
+                         static_cast<float>((request.bgcolor >> 16) & 0xFFu) / 255.f, 1.f);
+            g.Clear(kColorBufferBit);
+        }
+        else
+            drawCircuit(fbp2, request.dispfb2, dbx2, dby2, false);
+        g.Enable(kBlend);
+        g.BlendEquationSeparate(kFuncAdd, kFuncAdd);
+        if (mmod)
+        {
+            const float f = static_cast<float>(alp) / 255.f;
+            g.BlendColor(f, f, f, f);
+            g.BlendFuncSeparate(kConstantColor, kOneMinusConstantColor, kZero, kOne);
+        }
+        else
+            g.BlendFuncSeparate(0x0302 /*SRC_ALPHA*/, 0x0303 /*ONE_MINUS_SRC_ALPHA*/, kZero, kOne);
+        drawCircuit(fbp1, request.dispfb1, dbx1, dby1, true);
+        g.Disable(kBlend);
+    }
+    else
+        drawCircuit(fbp, ok1 ? request.dispfb1 : request.dispfb2, ok1 ? dbx1 : dbx2, ok1 ? dby1 : dby2, false);
+    g.BindVertexArray(d.vao);
+    // the displayed image is opaque: force alpha to 1 on the GPU (the host draws it with blending)
+    g.ColorMask(kFalse, kFalse, kFalse, kTrue);
+    g.ClearColor(0.f, 0.f, 0.f, 1.f);
+    g.Clear(kColorBufferBit);
+    g.ColorMask(kTrue, kTrue, kTrue, kTrue);
+    if (shared)
+    {
+        return PresentationFrame{};
+    }
+    d.readBackFrame(g, outW, outH, frame.pixels);
+    // the frontend packs presentation rows with a fixed 640 pixel stride
+    if (frame.width < 640u)
+    {
+        std::vector<uint8_t> rows(static_cast<size_t>(640u) * frame.height * 4u, 0u);
+        for (uint32_t y = 0; y < frame.height; ++y)
+            std::memcpy(rows.data() + static_cast<size_t>(y) * 640u * 4u, frame.pixels.data() + static_cast<size_t>(y) * frame.width * 4u,
+                        static_cast<size_t>(frame.width) * 4u);
+        frame.pixels = std::move(rows);
+    }
+    return frame;
+}
diff --git a/ps2xRuntime/src/lib/gs/gpu/gs_texture_store.cpp b/ps2xRuntime/src/lib/gs/gpu/gs_texture_store.cpp
new file mode 100644
index 0000000..9d7d1e4
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gpu/gs_texture_store.cpp
@@ -0,0 +1,338 @@
+// GOW-Port: native texture / CLUT store, see gs_texture_store.h.
+#include "gs_texture_store.h"
+#include "../gs_gpu_helpers.h"
+#include "runtime/gs/ps2_gs_memory.h"
+
+#include <algorithm>
+#include <cstring>
+#include <mutex>
+#include <stdexcept>
+
+using namespace GSCpuInternal;
+
+namespace
+{
+    // GS memory layout per PSM (swizzle tables of ps2_gs_memory): the game's own data layout.
+    uint32_t readPixel(uint8_t *vram, uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y)
+    {
+        using namespace GSMem;
+        switch (psm & 0x3Fu)
+        {
+        case GS_PSM_CT32: return ReadCT32(vram, base, bw, x, y);
+        case GS_PSM_CT24: return ReadCT24(vram, base, bw, x, y);
+        case GS_PSM_CT16: return ReadCT16(vram, base, bw, x, y);
+        case GS_PSM_CT16S: return ReadCT16S(vram, base, bw, x, y);
+        case GS_PSM_T8: return ReadP8(vram, base, bw, x, y);
+        case GS_PSM_T8H: return ReadP8H(vram, base, bw, x, y);
+        case GS_PSM_T4: return ReadP4(vram, base, bw, x, y);
+        case GS_PSM_T4HH: return ReadP4HH(vram, base, bw, x, y);
+        case GS_PSM_T4HL: return ReadP4HL(vram, base, bw, x, y);
+        case GS_PSM_Z32: return ReadZ32(vram, base, bw, x, y);
+        case GS_PSM_Z24: return ReadZ24(vram, base, bw, x, y);
+        case GS_PSM_Z16: return ReadZ16(vram, base, bw, x, y);
+        case GS_PSM_Z16S: return ReadZ16S(vram, base, bw, x, y);
+        default: return 0u;
+        }
+    }
+
+    void writePixel(uint8_t *vram, uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
+    {
+        using namespace GSMem;
+        switch (psm & 0x3Fu)
+        {
+        case GS_PSM_CT32: WriteCT32(vram, base, bw, x, y, value); break;
+        case GS_PSM_CT24: WriteCT24(vram, base, bw, x, y, value); break;
+        case GS_PSM_CT16: WriteCT16(vram, base, bw, x, y, value); break;
+        case GS_PSM_CT16S: WriteCT16S(vram, base, bw, x, y, value); break;
+        case GS_PSM_T8: WriteP8(vram, base, bw, x, y, value); break;
+        case GS_PSM_T8H: WriteP8H(vram, base, bw, x, y, value); break;
+        case GS_PSM_T4: WriteP4(vram, base, bw, x, y, value); break;
+        case GS_PSM_T4HH: WriteP4HH(vram, base, bw, x, y, value); break;
+        case GS_PSM_T4HL: WriteP4HL(vram, base, bw, x, y, value); break;
+        case GS_PSM_Z32: WriteZ32(vram, base, bw, x, y, value); break;
+        case GS_PSM_Z24: WriteZ24(vram, base, bw, x, y, value); break;
+        case GS_PSM_Z16: WriteZ16(vram, base, bw, x, y, value); break;
+        case GS_PSM_Z16S: WriteZ16S(vram, base, bw, x, y, value); break;
+        default: break;
+        }
+    }
+}
+
+void GSTextureStore::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    if (vram && vramSize < GSMem::MEMORY_SIZE)
+        throw std::invalid_argument("GS texture store requires the 4 MiB GS memory image");
+    static std::once_flag tablesOnce;
+    std::call_once(tablesOnce, [] { GSMem::InitLookupTables(); });
+    m_vram = vram;
+    m_vramSize = vramSize;
+    Reset();
+}
+
+void GSTextureStore::Reset()
+{
+    m_clut.fill(0u);
+    m_clutCbp.fill(0u);
+    m_transfer = {};
+    m_transfer.direction = 3u;
+    m_state = {};
+    m_state.direction = 3u;
+    m_upload24 = {};
+}
+
+// ---- CLUT ------------------------------------------------------------------------------------------------------------
+
+void GSTextureStore::LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut, const ClutSource &source)
+{
+    const bool fourBit = isFourBitIndexedPsm(tex0.psm);
+    if (!m_vram || (!fourBit && !isEightBitIndexedPsm(tex0.psm)))
+        return;
+    switch (tex0.cld) // CLD: 1 always, 2/3 always + set CBP0/1, 4/5 only when CBP differs from CBP0/1
+    {
+    case 1u: break;
+    case 2u: m_clutCbp[0] = tex0.cbp; break;
+    case 3u: m_clutCbp[1] = tex0.cbp; break;
+    case 4u: if (m_clutCbp[0] == tex0.cbp) return; m_clutCbp[0] = tex0.cbp; break;
+    case 5u: if (m_clutCbp[1] == tex0.cbp) return; m_clutCbp[1] = tex0.cbp; break;
+    default: return;
+    }
+
+    const bool sixteenBit = tex0.cpsm == GS_PSM_CT16 || tex0.cpsm == GS_PSM_CT16S;
+    const bool thirtyTwoBit = tex0.cpsm == GS_PSM_CT32 || tex0.cpsm == GS_PSM_CT24;
+    if (!sixteenBit && !thirtyTwoBit)
+        return;
+    const uint32_t entryCount = fourBit ? 16u : 256u;
+    const uint32_t destinationBase = (static_cast<uint32_t>(tex0.csa) & (sixteenBit ? 0x1Fu : 0x0Fu)) << 4u;
+    // CSM1 with a 32-bit 256-colour CLUT: entries below CSA*16 keep their previous values.
+    const bool loadCsm1Suffix = tex0.csm == 0u && thirtyTwoBit && !fourBit;
+    const uint32_t first = loadCsm1Suffix ? destinationBase : 0u;
+    // CSM1: 16x16 (8x2 for 16 colours) block with bits 3 and 4 of the index swapped, in a 64 px wide buffer;
+    // CSM2: one line at (COU*16, COV) of a CBW-wide buffer
+    const uint32_t sourceWidth = tex0.csm == 0u ? 1u : (texclut.cbw != 0u ? static_cast<uint32_t>(texclut.cbw) : 1u);
+    std::array<uint16_t, 512> xy{};
+    const uint32_t count = entryCount - first;
+    for (uint32_t i = 0; i < count; ++i)
+    {
+        const uint32_t entry = first + i;
+        if (tex0.csm == 0u)
+        {
+            const uint32_t sourceIndex = swizzleClutIndexCSM1(entry);
+            xy[i * 2u] = static_cast<uint16_t>(sourceIndex & 0x0Fu);
+            xy[i * 2u + 1u] = static_cast<uint16_t>(sourceIndex >> 4u);
+        }
+        else
+        {
+            xy[i * 2u] = static_cast<uint16_t>((static_cast<uint32_t>(texclut.cou) << 4u) + entry);
+            xy[i * 2u + 1u] = static_cast<uint16_t>(texclut.cov);
+        }
+    }
+    std::array<uint32_t, 256> words{};
+    if (!source || !source(tex0, sourceWidth, xy.data(), count, words.data()))
+        for (uint32_t i = 0; i < count; ++i)
+            words[i] = readPixel(m_vram, tex0.cpsm, tex0.cbp, sourceWidth, xy[i * 2u], xy[i * 2u + 1u]);
+    for (uint32_t i = 0; i < count; ++i)
+    {
+        const uint32_t entry = first + i, raw = words[i];
+        const uint32_t destination = (loadCsm1Suffix ? entry : destinationBase + entry) & (sixteenBit ? 0x1FFu : 0x0FFu);
+        if (sixteenBit)
+            m_clut[destination] = static_cast<uint16_t>(raw);
+        else
+        {
+            m_clut[destination] = static_cast<uint16_t>(raw & 0xFFFFu);
+            m_clut[destination + 256u] = static_cast<uint16_t>(raw >> 16u);
+        }
+    }
+}
+
+uint64_t GSTextureStore::ClutHash() const
+{
+    uint64_t hash = 1469598103934665603ull;
+    for (uint16_t v : m_clut)
+        hash = (hash ^ v) * 1099511628211ull;
+    return hash;
+}
+
+uint32_t GSTextureStore::ClutColor(const GSDrawState &state, uint32_t index) const
+{
+    const GSTex0Reg &t = state.context.tex0;
+    const bool sixteenBit = t.cpsm == GS_PSM_CT16 || t.cpsm == GS_PSM_CT16S;
+    const uint32_t clutBase = (static_cast<uint32_t>(t.csa) & (sixteenBit ? 0x1Fu : 0x0Fu)) << 4u;
+    const uint32_t sourceIndex = isFourBitIndexedPsm(t.psm) ? (index & 0x0Fu) : (index & 0xFFu);
+    uint32_t clutIndex = (clutBase + sourceIndex) & (sixteenBit ? 0x1FFu : 0x0FFu);
+    if (!sixteenBit && t.csm == 0u && isEightBitIndexedPsm(t.psm))
+        clutIndex = std::min((sourceIndex & 0xF0u) + clutBase, 240u) + (sourceIndex & 0x0Fu);
+    switch (t.cpsm)
+    {
+    case GS_PSM_CT32:
+        return applyTexa(state.texa, t.cpsm, static_cast<uint32_t>(m_clut[clutIndex]) | (static_cast<uint32_t>(m_clut[clutIndex + 256u]) << 16u));
+    case GS_PSM_CT24:
+        return applyTexa(state.texa, t.cpsm, (static_cast<uint32_t>(m_clut[clutIndex]) | (static_cast<uint32_t>(m_clut[clutIndex + 256u]) << 16u)) & 0x00FFFFFFu);
+    case GS_PSM_CT16:
+    case GS_PSM_CT16S:
+        return applyTexa(state.texa, t.cpsm, Rgba5551ToRgba8888(m_clut[clutIndex]));
+    default:
+        return 0xFFFF00FFu;
+    }
+}
+
+void GSTextureStore::BuildPalette(const GSDrawState &state, uint32_t out[256]) const
+{
+    for (uint32_t i = 0; i < 256u; ++i)
+        out[i] = ClutColor(state, i);
+}
+
+void GSTextureStore::DecodeTextureRgba(const GSDrawState &state, std::vector<uint32_t> &out) const
+{
+    const GSTex0Reg &t = state.context.tex0;
+    const uint32_t w = std::max<uint32_t>(1u, state.textureWidth), h = std::max<uint32_t>(1u, state.textureHeight);
+    const uint64_t clamp = state.context.clamp;
+    const uint8_t wrapU = static_cast<uint8_t>(clamp & 0x3u), wrapV = static_cast<uint8_t>((clamp >> 2) & 0x3u);
+    const uint16_t minU = static_cast<uint16_t>((clamp >> 4) & 0x3FFu), maxU = static_cast<uint16_t>((clamp >> 14) & 0x3FFu);
+    const uint16_t minV = static_cast<uint16_t>((clamp >> 24) & 0x3FFu), maxV = static_cast<uint16_t>((clamp >> 34) & 0x3FFu);
+    out.resize(static_cast<size_t>(w) * h);
+    for (uint32_t y = 0; y < h; ++y)
+        for (uint32_t x = 0; x < w; ++x)
+        {
+            const int u = wrapTextureCoordinate(static_cast<int>(std::min<uint32_t>(x, 4095u)), static_cast<int>(w), wrapU, minU, maxU);
+            const int v = wrapTextureCoordinate(static_cast<int>(std::min<uint32_t>(y, 4095u)), static_cast<int>(h), wrapV, minV, maxV);
+            const uint32_t raw = m_vram ? readPixel(m_vram, t.psm, t.tbp0, t.tbw, static_cast<uint32_t>(u), static_cast<uint32_t>(v)) : 0u;
+            uint32_t texel = 0xFFFF00FFu;
+            switch (t.psm)
+            {
+            case GS_PSM_CT32: case GS_PSM_Z32: case GS_PSM_CT24: case GS_PSM_Z24:
+                texel = applyTexa(state.texa, t.psm, raw);
+                break;
+            case GS_PSM_CT16: case GS_PSM_CT16S: case GS_PSM_Z16: case GS_PSM_Z16S:
+                texel = applyTexa(state.texa, t.psm, Rgba5551ToRgba8888(static_cast<uint16_t>(raw)));
+                break;
+            case GS_PSM_T8: case GS_PSM_T8H: case GS_PSM_T4: case GS_PSM_T4HL: case GS_PSM_T4HH:
+                texel = ClutColor(state, raw & 0xFFu);
+                break;
+            default:
+                break;
+            }
+            out[static_cast<size_t>(y) * w + x] = texel;
+        }
+}
+
+// ---- transfers -------------------------------------------------------------------------------------------------------
+
+void GSTextureStore::BeginTransfer(const GSTransferCommand &command)
+{
+    m_transfer = command;
+    m_upload24 = {};
+    m_state.x = command.trxpos.dsax;
+    m_state.y = command.trxpos.dsay;
+    m_state.totalPixels = static_cast<uint32_t>(command.trxreg.rrw) * static_cast<uint32_t>(command.trxreg.rrh);
+    m_state.copiedPixels = 0u;
+    m_state.direction = command.direction;
+    m_state.localToHostPendingBytes = 0u;
+    if (command.direction == 2u)
+        CopyLocalToLocal();
+    else if (command.direction == 1u)
+        m_state.copiedPixels = m_state.totalPixels; // nothing is read back (never used by the game)
+}
+
+void GSTextureStore::Upload(const uint8_t *data, uint32_t sizeBytes)
+{
+    if (!data || !sizeBytes || !m_vram || m_state.direction != 0u || !m_state.totalPixels)
+        return;
+    if (m_transfer.bitbltbuf.dpsm == GS_PSM_CT24 || m_transfer.bitbltbuf.dpsm == GS_PSM_Z24)
+        m_upload24.consume(data, sizeBytes, [&](const uint8_t *aligned, uint32_t bytes) {
+            UploadAligned(aligned, bytes);
+            return m_state.direction == 0u;
+        });
+    else
+        UploadAligned(data, sizeBytes);
+}
+
+// Host->local pixels in transfer order (left to right, top to bottom inside the TRXPOS/TRXREG rectangle).
+void GSTextureStore::UploadAligned(const uint8_t *data, uint32_t sizeBytes)
+{
+    if (!data || sizeBytes == 0u || !m_vram || m_state.direction != 0u)
+        return;
+    if (m_transfer.trxreg.rrw == 0u || m_transfer.trxreg.rrh == 0u || m_state.totalPixels == 0u)
+        return;
+    const uint32_t dbp = m_transfer.bitbltbuf.dbp;
+    const uint32_t dbw = std::max<uint32_t>(m_transfer.bitbltbuf.dbw, 1u);
+    const uint8_t dpsm = m_transfer.bitbltbuf.dpsm;
+    const uint32_t rrw = m_transfer.trxreg.rrw;
+    const uint32_t dsax = m_transfer.trxpos.dsax, dsay = m_transfer.trxpos.dsay;
+    auto advance = [&](uint32_t count)
+    {
+        m_state.copiedPixels = std::min<uint32_t>(m_state.totalPixels, m_state.copiedPixels + count);
+        if (m_state.copiedPixels >= m_state.totalPixels)
+        {
+            m_state.direction = 3u;
+            m_state.totalPixels = 0u;
+            return;
+        }
+        m_state.x = dsax + (m_state.copiedPixels % rrw);
+        m_state.y = dsay + (m_state.copiedPixels / rrw);
+    };
+    uint32_t bits;
+    switch (dpsm)
+    {
+    case GS_PSM_CT32: case GS_PSM_Z32: bits = 32u; break;
+    case GS_PSM_CT24: case GS_PSM_Z24: bits = 24u; break;
+    case GS_PSM_CT16: case GS_PSM_CT16S: case GS_PSM_Z16: case GS_PSM_Z16S: bits = 16u; break;
+    case GS_PSM_T8: case GS_PSM_T8H: bits = 8u; break;
+    case GS_PSM_T4: case GS_PSM_T4HL: case GS_PSM_T4HH: bits = 4u; break;
+    default: return;
+    }
+    // Whole pixels in this chunk (a 24 bit pixel split across chunks is joined by Upload), written one row run at a time.
+    const uint32_t avail = static_cast<uint32_t>((static_cast<uint64_t>(sizeBytes) * 8u) / bits);
+    uint32_t done = 0u;
+    while (done < avail && m_state.direction == 0u)
+    {
+        const uint32_t n = std::min({dsax + rrw - m_state.x, avail - done, m_state.totalPixels - m_state.copiedPixels});
+        GSMem::WriteRun(m_vram, dpsm, dbp, dbw, m_state.x, m_state.y, data, done, n);
+        done += n;
+        advance(n);
+    }
+}
+
+void GSTextureStore::CopyLocalToLocal()
+{
+    const uint32_t rrw = m_transfer.trxreg.rrw, rrh = m_transfer.trxreg.rrh, total = rrw * rrh;
+    if (m_vram && total != 0u)
+    {
+        const GSBitBltBuf &b = m_transfer.bitbltbuf;
+        const GSTrxPos &p = m_transfer.trxpos;
+        for (uint32_t pixel = 0; pixel < total; ++pixel)
+        {
+            uint32_t x = pixel % rrw, y = pixel / rrw;
+            if ((p.dir & 0x2u) != 0u)
+                x = rrw - x - 1u;
+            if ((p.dir & 0x1u) != 0u)
+                y = rrh - y - 1u;
+            const uint32_t value = readPixel(m_vram, b.spsm, b.sbp, std::max<uint32_t>(b.sbw, 1u), x + p.ssax, y + p.ssay);
+            writePixel(m_vram, b.dpsm, b.dbp, std::max<uint32_t>(b.dbw, 1u), x + p.dsax, y + p.dsay, value);
+        }
+    }
+    m_state.copiedPixels = total;
+    m_state.direction = 3u;
+}
+
+// ---- raw access ------------------------------------------------------------------------------------------------------
+
+uint32_t GSTextureStore::Read(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const
+{
+    return m_vram ? readPixel(m_vram, psm, base, bw, x, y) : 0u;
+}
+
+void GSTextureStore::Write(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
+{
+    if (m_vram)
+        writePixel(m_vram, psm, base, bw, x, y, value);
+}
+
+void GSTextureStore::Snapshot(std::vector<uint8_t> &out) const
+{
+    if (!m_vram || m_vramSize == 0u)
+    {
+        out.clear();
+        return;
+    }
+    out.assign(m_vram, m_vram + m_vramSize);
+}
diff --git a/ps2xRuntime/src/lib/gs/gpu/gs_texture_store.h b/ps2xRuntime/src/lib/gs/gpu/gs_texture_store.h
new file mode 100644
index 0000000..ed807df
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gpu/gs_texture_store.h
@@ -0,0 +1,59 @@
+// GOW-Port: native texture / CLUT store of the GS renderer (GSHwBackend).
+// Keeps the bytes the game uploads (HOST->LOCAL image transfers, LOCAL->LOCAL copies) at their GS block addresses in
+// the 4 MiB GS memory image, because the game uploads data in one format and reads it back in another (PSMT8 textures
+// from CT32 uploads, CT24 from CT32): the swizzle/address math is how the game's data is laid out, not a hardware model.
+// It also holds the CLUT the game loads (CLD rules of TEX0) and builds palettes from it. There is no rasteriser, no
+// framebuffer and no LOCAL->HOST readback here: all drawing is done by the renderer on the GPU.
+// Single-threaded: it is only used from the thread that drives GSHwBackend (the GS worker).
+#pragma once
+
+#include "runtime/gs/gs_types.h"
+#include "runtime/gs/gs_upload24.h"
+
+#include <array>
+#include <cstdint>
+#include <functional>
+#include <vector>
+
+class GSTextureStore
+{
+public:
+    void Initialize(uint8_t *vram, uint32_t vramSize);
+    void Reset();
+
+    // Where a CLUT load reads its source pixels when they are not the uploaded bytes: the renderer, when TEX0.CBP lies in a
+    // render target. Gets the `count` source pixels as (x, y) pairs of a `width` (64 px units) wide TEX0.CPSM buffer at
+    // TEX0.CBP and writes their raw words; returns false when that memory holds no render target.
+    using ClutSource = std::function<bool(const GSTex0Reg &tex0, uint32_t width, const uint16_t *xy, uint32_t count, uint32_t *words)>;
+    // TEX0 with an indexed PSM: load the CLUT when TEX0.CLD says so, from `source` or else from the uploaded bytes.
+    void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut, const ClutSource &source = {});
+    uint64_t ClutHash() const;
+    // 256-entry RGBA palette for the indexed texture described by `state` (CSA/CSM/CPSM + TEXA applied).
+    void BuildPalette(const GSDrawState &state, uint32_t out[256]) const;
+    // Point-sampled RGBA texels of the texture selected by `state` (generic path for formats without a direct layout).
+    void DecodeTextureRgba(const GSDrawState &state, std::vector<uint32_t> &out) const;
+
+    // TRXDIR: 0 = host->local (bytes follow through Upload), 2 = local->local (done at once), 1 = local->host (not
+    // served: the game never reads GS memory back), 3 = none.
+    void BeginTransfer(const GSTransferCommand &command);
